# Copy to .env.local and fill in values from your Supabase project dashboard.
# In Vercel, set these under Project Settings -> Environment Variables for Production and Preview.
#
# The web app auto-detects missing values and falls back to demo mode,
# so you can ship preview builds without secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
