node_modules/
.pnpm-store/

.next/
dist/
build/

artifacts/
agent/artifacts/

# Personal data: ignore EVERYTHING under agent/data/ by default and
# allowlist only the public, shippable bits. This is deny-by-default so
# any NEW file the agent writes (state, caches, screenshots, drafts)
# can never accidentally reach the public repo.
agent/data/*
!agent/data/company_pools/
!agent/data/company_pools/**
!agent/data/*.example.json

instaply-dev.log

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

*.tsbuildinfo
__pycache__/
*.pyc

# MCP build artifacts (regenerated by mcpb pack on every release)
# Note: apps/web/public/instaply.mcpb is the hosted bundle and IS tracked.
mcp/bundle/
mcp/dist/
.pytest_cache/
.vercel
.claude/
supabase/.temp/
.env*.local
