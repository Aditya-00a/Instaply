{
  "manifest_version": 3,
  "name": "Instaply",
  "version": "0.0.1",
  "description": "Helps Instaply complete job applications in your browser when captcha or verification is required.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*/jobs/*",
        "https://boards.greenhouse.io/*/jobs/*"
      ],
      "js": ["content/_fillers.js", "content/greenhouse.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.lever.co/*"
      ],
      "js": ["content/_fillers.js", "content/lever.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Instaply",
    "default_popup": "popup/popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://instaply.asion.ai/*",
      "http://localhost:3000/*"
    ]
  }
}
